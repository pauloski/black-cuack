# Cabeceras de Cloudflare Pages para la landing.
#
# noindex: para quitarlo cuando la landing sea pública, borra el bloque X-Robots-Tag
# de abajo Y la etiqueta <meta name="robots" ...> de index.html.

/*
  X-Robots-Tag: noindex, nofollow

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/version.json
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=86400
